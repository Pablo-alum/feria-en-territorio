---
---

<section id="inicio" class="relative overflow-hidden">
  <!-- Doodles flotantes de fondo -->
  <svg class="absolute left-[4%] top-24 hidden w-16 animate-float text-clay md:block" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 40 C20 20 44 20 52 40 C44 34 20 34 12 40 Z" fill="currentColor" opacity="0.25" />
    <path d="M12 40 C20 20 44 20 52 40" />
    <line x1="32" y1="40" x2="32" y2="54" />
  </svg>
  <svg class="absolute right-[6%] top-40 hidden w-14 animate-float-slow text-sky md:block" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true">
    <path d="M8 40 Q16 28 28 34 Q40 40 48 28" />
    <circle cx="14" cy="16" r="3" fill="currentColor" stroke="none" />
    <circle cx="42" cy="14" r="3" fill="currentColor" stroke="none" />
  </svg>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-28 pt-14 sm:px-6 lg:grid-cols-2 lg:gap-8 lg:pt-20">
    <!-- Texto -->
    <div class="relative z-10 text-center lg:text-left">
      <span class="eyebrow animate-bob">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#4CAF50" aria-hidden="true"><path d="M12 2C7 7 5 11 5 15a7 7 0 0 0 14 0c0-4-2-8-7-13Z"/></svg>
        Feria familiar · Productos naturales
      </span>

      <h1 class="mt-6 font-display text-5xl font-extrabold leading-[0.95] tracking-tight sm:text-6xl lg:text-7xl">
        Un día de
        <span class="relative inline-block text-grass-dark">
          feria,
          <svg class="absolute -bottom-3 left-0 w-full" viewBox="0 0 200 14" fill="none" aria-hidden="true">
            <path d="M4 10 Q30 2 60 8 T120 8 T196 6" stroke="#E8862E" stroke-width="6" stroke-linecap="round" />
          </svg>
        </span>
        <br />
        <span class="text-clay">juego</span> y <span class="text-sky-dark">naturaleza</span>
      </h1>

      <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-muted lg:mx-0">
        Productos frescos de productores locales, talleres para chicos y grandes,
        música al aire libre y mucho color. Vení con tu familia a celebrar lo natural,
        lo artesanal y lo nuestro.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4 lg:justify-start">
        <a href="#calendario" class="btn-primary">
          Ver próximas ferias
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#sobre-nosotros" class="btn-outline">Conocé la feria</a>
      </div>

      <dl class="mt-12 flex flex-wrap justify-center gap-x-10 gap-y-4 lg:justify-start">
        <div>
          <dt class="font-display text-3xl font-extrabold text-grass-dark">+40</dt>
          <dd class="text-sm font-bold uppercase tracking-wider text-muted">Puestos</dd>
        </div>
        <div>
          <dt class="font-display text-3xl font-extrabold text-clay">+200</dt>
          <dd class="text-sm font-bold uppercase tracking-wider text-muted">Familias</dd>
        </div>
        <div>
          <dt class="font-display text-3xl font-extrabold text-sky-dark">100%</dt>
          <dd class="text-sm font-bold uppercase tracking-wider text-muted">Natural</dd>
        </div>
      </dl>
    </div>

    <!-- Ilustración central -->
    <div class="relative mx-auto w-full max-w-lg">
      <!-- Blob de fondo -->
      <div class="absolute inset-0 -z-0 scale-110 animate-spin-slow rounded-[44%_56%_58%_42%/48%_42%_58%_52%] bg-sun-light" aria-hidden="true"></div>
      <div class="absolute inset-4 scale-105 rounded-[58%_42%_40%_60%/55%_48%_52%_45%] bg-sky-light/60" aria-hidden="true"></div>

      <svg viewBox="0 0 520 420" class="relative z-10 w-full drop-shadow-[6px_6px_0_rgba(47,58,47,0.15)]" role="img" aria-label="Ilustración de una feria al aire libre con un puesto de frutas, árboles, sol y una mariposa">
        <!-- Sol -->
        <g style="transform-box: fill-box; transform-origin: center;">
          <g class="animate-spin-slow">
            <g stroke="#2F3A2F" stroke-width="5" stroke-linecap="round">
              <line x1="430" y1="40" x2="430" y2="18" />
              <line x1="465" y1="55" x2="480" y2="40" />
              <line x1="480" y1="90" x2="502" y2="90" />
              <line x1="395" y1="55" x2="380" y2="40" />
            </g>
          </g>
          <circle cx="430" cy="90" r="32" fill="#FFC53D" stroke="#2F3A2F" stroke-width="5" />
          <circle cx="420" cy="84" r="4" fill="#2F3A2F" />
          <circle cx="440" cy="84" r="4" fill="#2F3A2F" />
          <path d="M418 98 Q430 108 442 98" fill="none" stroke="#2F3A2F" stroke-width="4" stroke-linecap="round" />
        </g>

        <!-- Nube -->
        <g class="animate-float-slow">
          <path d="M90 70 q0 -18 20 -18 q6 -14 24 -10 q14 -8 24 4 q16 -2 16 14 q12 2 8 12 q-2 8 -14 8 l-70 0 q-14 0 -12 -12 Z" fill="#fff" stroke="#2F3A2F" stroke-width="5" stroke-linejoin="round" />
        </g>

        <!-- Colinas -->
        <path d="M0 330 Q130 250 260 315 Q390 370 520 300 L520 420 L0 420 Z" fill="#A5D6A7" stroke="#2F3A2F" stroke-width="5" />
        <path d="M0 365 Q160 310 320 355 Q440 385 520 350 L520 420 L0 420 Z" fill="#4CAF50" stroke="#2F3A2F" stroke-width="5" />

        <!-- Árbol izquierdo -->
        <g>
          <rect x="52" y="240" width="18" height="80" rx="8" fill="#8D5A3A" stroke="#2F3A2F" stroke-width="5" />
          <circle cx="61" cy="212" r="42" fill="#2E7D32" stroke="#2F3A2F" stroke-width="5" />
          <circle cx="38" cy="230" r="24" fill="#4CAF50" stroke="#2F3A2F" stroke-width="5" />
          <circle cx="86" cy="230" r="24" fill="#4CAF50" stroke="#2F3A2F" stroke-width="5" />
          <circle cx="48" cy="204" r="5" fill="#E8543F" />
          <circle cx="76" cy="220" r="5" fill="#E8543F" />
        </g>

        <!-- Puesto de feria -->
        <g>
          <!-- Toldo -->
          <path d="M170 160 L390 160 L400 205 Q385 220 370 205 Q355 222 340 205 Q325 222 310 205 Q295 222 280 205 Q265 222 250 205 Q235 222 220 205 Q205 222 190 205 Q178 218 160 205 Z" fill="#E8543F" stroke="#2F3A2F" stroke-width="5" stroke-linejoin="round" />
          <path d="M205 160 L205 200 M245 160 L245 203 M285 160 L285 203 M325 160 L325 203 M365 160 L365 200" stroke="#fff" stroke-width="12" />
          <path d="M205 160 L205 200 M245 160 L245 203 M285 160 L285 203 M325 160 L325 203 M365 160 L365 200" stroke="#2F3A2F" stroke-width="4" fill="none" />
          <!-- Postes y mesa -->
          <line x1="180" y1="205" x2="180" y2="330" stroke="#2F3A2F" stroke-width="7" stroke-linecap="round" />
          <line x1="380" y1="205" x2="380" y2="330" stroke="#2F3A2F" stroke-width="7" stroke-linecap="round" />
          <rect x="165" y="292" width="230" height="16" rx="8" fill="#F5B87E" stroke="#2F3A2F" stroke-width="5" />
          <rect x="180" y="308" width="14" height="30" fill="#C56A1B" stroke="#2F3A2F" stroke-width="4" />
          <rect x="356" y="308" width="14" height="30" fill="#C56A1B" stroke="#2F3A2F" stroke-width="4" />
          <!-- Frutas en la mesa -->
          <circle cx="215" cy="278" r="14" fill="#E8543F" stroke="#2F3A2F" stroke-width="4" />
          <circle cx="248" cy="274" r="15" fill="#FFC53D" stroke="#2F3A2F" stroke-width="4" />
          <circle cx="282" cy="278" r="14" fill="#8BC34A" stroke="#2F3A2F" stroke-width="4" />
          <circle cx="315" cy="274" r="15" fill="#E8543F" stroke="#2F3A2F" stroke-width="4" />
          <circle cx="348" cy="279" r="13" fill="#9C27B0" stroke="#2F3A2F" stroke-width="4" />
          <!-- Cartel -->
          <rect x="238" y="216" width="84" height="34" rx="10" fill="#FFF6E3" stroke="#2F3A2F" stroke-width="5" />
          <text x="280" y="240" text-anchor="middle" font-family="Baloo 2, sans-serif" font-weight="800" font-size="19" fill="#2E7D32">FERIA</text>
        </g>

        <!-- Arbusto derecho -->
        <g>
          <circle cx="452" cy="330" r="30" fill="#2E7D32" stroke="#2F3A2F" stroke-width="5" />
          <circle cx="486" cy="342" r="22" fill="#4CAF50" stroke="#2F3A2F" stroke-width="5" />
          <circle cx="444" cy="322" r="4" fill="#E8543F" />
          <circle cx="462" cy="338" r="4" fill="#FFC53D" />
        </g>

        <!-- Pasto -->
        <g stroke="#2F3A2F" stroke-width="4" stroke-linecap="round" fill="none">
          <path d="M120 392 q2 -14 8 -16 M132 394 q6 -12 14 -12" />
          <path d="M300 398 q2 -14 8 -16 M312 400 q6 -12 14 -12" />
          <path d="M420 392 q2 -14 8 -16" />
        </g>

        <!-- Mariposa -->
        <g class="animate-float">
          <path d="M120 120 q-18 -22 -34 -8 q-10 12 8 22 q-22 0 -20 16 q2 14 22 6 q-8 14 6 16 q12 2 18 -14 Z" fill="#C65D8C" stroke="#2F3A2F" stroke-width="4" stroke-linejoin="round" />
          <path d="M120 120 q18 -22 34 -8 q10 12 -8 22 q22 0 20 16 q-2 14 -22 6 q8 14 -6 16 q-12 2 -18 -14 Z" fill="#E886B0" stroke="#2F3A2F" stroke-width="4" stroke-linejoin="round" />
          <ellipse cx="120" cy="128" rx="5" ry="16" fill="#2F3A2F" />
        </g>
      </svg>
    </div>
  </div>

  <!-- Onda inferior -->
  <svg class="block h-14 w-full text-paper sm:h-20" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0,80 L0,46 C180,10 360,70 540,44 C720,18 900,66 1080,42 C1260,18 1380,52 1440,36 L1440,80 Z" />
  </svg>
</section>
