---
const year = new Date().getFullYear();
---

<footer class="relative mt-24 bg-grass-dark text-cream">
  <!-- Onda decorativa superior -->
  <svg class="absolute -top-12 left-0 h-12 w-full text-grass-dark" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0,48 L0,28 C120,8 240,44 360,30 C480,16 600,4 720,20 C840,36 960,44 1080,30 C1200,16 1320,8 1440,24 L1440,48 Z" />
  </svg>

  <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 py-14 text-center sm:px-6">
    <div>
      <p class="font-display text-2xl font-bold">Feria en Territorio</p>
      <p class="mt-1 text-sm text-grass-light">Naturaleza, arte y comunidad en un solo lugar.</p>
    </div>

    <nav aria-label="Navegación del pie de página">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 font-bold">
        <li><a class="rounded-full px-2 py-1 hover:text-sun" href="#inicio">Inicio</a></li>
        <li><a class="rounded-full px-2 py-1 hover:text-sun" href="#sobre-nosotros">Sobre nosotros</a></li>
        <li><a class="rounded-full px-2 py-1 hover:text-sun" href="#categorias">Categorías</a></li>
        <li><a class="rounded-full px-2 py-1 hover:text-sun" href="#calendario">Calendario</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-4" aria-label="Redes sociales">
      <a href="#" aria-label="Facebook" class="rounded-full border-2 border-cream/60 p-2.5 transition-transform hover:-translate-y-1 hover:border-sun hover:text-sun">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.6l.4-3h-3V9.1c0-.9.3-1.5 1.6-1.5h1.5V4.9c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v3h2.7v7h2.8Z"/></svg>
      </a>
      <a href="#" aria-label="Instagram" class="rounded-full border-2 border-cream/60 p-2.5 transition-transform hover:-translate-y-1 hover:border-sun hover:text-sun">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="#" aria-label="YouTube" class="rounded-full border-2 border-cream/60 p-2.5 transition-transform hover:-translate-y-1 hover:border-sun hover:text-sun">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z"/></svg>
      </a>
    </div>

    <p class="text-xs text-grass-light">© {year} Feria en Territorio. Hecho con cariño y al aire libre.</p>
  </div>
</footer>
